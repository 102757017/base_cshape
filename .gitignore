# ============================================================
# 核心原则：只提交源代码和项目定义文件，
# 不提交编译产物、临时文件和个人配置。
# ============================================================

# ---------- Visual Studio 用户/个人配置文件 ----------
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.ide
*.DotSettings.user
*.csproj.user

# ---------- IDE 缓存与目录 ----------
.vs/
.idea/

# ---------- 编译产物（bin / obj） ----------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
