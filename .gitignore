.exe

# ---------- ClickOnce / 发布输出 ----------
publish/
[Aa]pp[Pp]ackages/
*.publishsettings
*.pubxml
*.azurePubxml

# ---------- NuGet 包（由 Package Restore 还原，不提交） ----------
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
*.snupkg

# ---------- 测试与代码覆盖率结果 ----------
[Tt]est[Rr]esults/
*.coverage
*.coveragexml
_NCrunch_*
_ReSharper*/
*.dotCover

# ---------- 临时 / 系统文件 ----------
*.tmp
*~
~$*
*.log
Thumbs.db
Desktop.ini
[Dd]ockForm/Logs/
**/[Ll]og*/

# ---------- 生成的中间文件 ----------
*.userprefs
*.psess
*.vsp
*.vspx
*.sap
*.cache
